{
  "name": "@backstage-community/plugin-rbac",
  "version": "2.4.1",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "rbac",
    "pluginPackages": [
      "@backstage-community/plugin-rbac",
      "@backstage-community/plugin-rbac-backend",
      "@backstage-community/plugin-rbac-common",
      "@backstage-community/plugin-rbac-node"
    ]
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha/index.ts",
    "./legacy": "./src/legacy/index.ts",
    "./translations": "./src/alpha/translations/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha/index.ts"
      ],
      "legacy": [
        "src/legacy/index.ts"
      ],
      "translations": [
        "src/alpha/translations/index.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint:check": "backstage-cli package lint",
    "lint:fix": "backstage-cli package lint --fix",
    "postpack": "backstage-cli package postpack",
    "prepack": "backstage-cli package prepack",
    "start": "backstage-cli package start",
    "start:legacy": "backstage-cli package start --entrypoint dev/legacy/index.tsx",
    "start:mock": "backstage-cli package start --entrypoint dev/index.mock.tsx",
    "start:legacy:mock": "backstage-cli package start --entrypoint dev/legacy/index.mock.tsx",
    "start:multi-user": "backstage-cli package start --config ../../app-config.yaml --config app-config.multi-user.yaml",
    "test": "backstage-cli package test --passWithNoTests --coverage",
    "tsc": "tsc",
    "prettier:check": "prettier --ignore-unknown --check .",
    "prettier:fix": "prettier --ignore-unknown --write .",
    "ui-test": "yarn --cwd ../.. test:nfs --project=en",
    "ui-test:legacy": "yarn --cwd ../.. test:legacy --project=en"
  },
  "dependencies": {
    "@backstage-community/plugin-rbac-common": "workspace:^",
    "@backstage/catalog-model": "^1.10.2",
    "@backstage/core-components": "^0.18.15",
    "@backstage/core-plugin-api": "^1.12.11",
    "@backstage/frontend-plugin-api": "^0.18.2",
    "@backstage/plugin-app-react": "^0.2.8",
    "@backstage/plugin-catalog": "^2.0.10",
    "@backstage/plugin-permission-common": "^0.9.12",
    "@backstage/plugin-permission-react": "^0.5.6",
    "@backstage/theme": "^0.7.3",
    "@backstage/ui": "^0.19.0",
    "@mui/icons-material": "5.18.0",
    "@mui/material": "^5.14.18",
    "@remixicon/react": ">=4.6.0 <4.9.0",
    "@rjsf/core": "^5.21.2",
    "@rjsf/mui": "^5.21.2",
    "@rjsf/utils": "^5.21.2",
    "@rjsf/validator-ajv8": "^5.21.2",
    "autosuggest-highlight": "^3.3.4",
    "formik": "^2.4.5",
    "react-use": "^17.4.0",
    "yup": "^1.3.2"
  },
  "peerDependencies": {
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@backstage/cli": "^0.36.7",
    "@backstage/core-app-api": "^1.20.6",
    "@backstage/dev-utils": "^1.1.28",
    "@backstage/frontend-defaults": "^0.5.7",
    "@backstage/frontend-test-utils": "^0.6.5",
    "@backstage/plugin-user-settings": "^0.9.8",
    "@backstage/test-utils": "^1.7.23",
    "@backstage/ui": "^0.19.0",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/react-hooks": "8.0.1",
    "@testing-library/user-event": "14.6.9",
    "@types/autosuggest-highlight": "3.2.4",
    "@types/node": "22.20.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18",
    "msw": "1.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.0.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/community-plugins",
    "directory": "workspaces/rbac/plugins/rbac"
  },
  "keywords": [
    "backstage",
    "plugin"
  ],
  "bugs": "https://github.com/backstage/community-plugins/issues",
  "maintainers": [
    "@PatAKnight"
  ],
  "author": "Red Hat",
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
