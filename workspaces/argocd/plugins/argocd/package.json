{
  "name": "@backstage-community/plugin-argocd",
  "version": "3.1.2",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "backstage-community-argocd",
    "pluginPackage": "@backstage-community/plugin-argocd",
    "pluginPackages": [
      "@backstage-community/plugin-argocd",
      "@backstage-community/plugin-argocd-backend",
      "@backstage-community/plugin-argocd-common",
      "@backstage-community/plugin-argocd-node"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./legacy": "./src/legacy.ts",
    "./translations": "./src/translations/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "legacy": [
        "src/legacy.ts"
      ],
      "translations": [
        "src/translations/index.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "postpack": "backstage-cli package postpack",
    "prepack": "backstage-cli package prepack",
    "start": "backstage-cli package start",
    "start:mock": "backstage-cli package start --entrypoint dev/index.mock.tsx",
    "start:legacy": "backstage-cli package start --entrypoint dev/legacy",
    "test": "backstage-cli package test --passWithNoTests --coverage",
    "tsc": "tsc",
    "ui-test": "yarn playwright test"
  },
  "dependencies": {
    "@backstage-community/plugin-argocd-common": "workspace:^",
    "@backstage/catalog-model": "^1.10.1",
    "@backstage/core-components": "^0.18.14",
    "@backstage/core-plugin-api": "^1.12.10",
    "@backstage/frontend-plugin-api": "^0.18.1",
    "@backstage/plugin-app-react": "^0.2.7",
    "@backstage/plugin-catalog-react": "^3.2.3",
    "@backstage/plugin-kubernetes-react": "^0.6.0",
    "@backstage/plugin-permission-react": "^0.5.5",
    "@backstage/theme": "^0.7.3",
    "@backstage/ui": "^0.18.0",
    "@kubernetes/client-node": "^1.0.0",
    "@mui/icons-material": "^5.15.16",
    "@mui/material": "^5.15.16",
    "@patternfly/react-core": "^6.0.0",
    "@patternfly/react-icons": "^6.0.0",
    "moment": "^2.30.1",
    "pluralize": "^8.0.0",
    "react-use": "17.6.1"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@backstage/cli": "^0.36.6",
    "@backstage/config": "^1.3.9",
    "@backstage/dev-utils": "^1.1.27",
    "@backstage/filter-predicates": "^0.1.5",
    "@backstage/frontend-defaults": "^0.5.6",
    "@backstage/frontend-test-utils": "^0.6.4",
    "@backstage/plugin-catalog": "^2.0.9",
    "@backstage/plugin-permission-common": "^0.9.11",
    "@backstage/plugin-user-settings": "^0.9.7",
    "@backstage/test-utils": "^1.7.22",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^18",
    "react-router-dom": "^6.3.0"
  },
  "files": [
    "app-config.dynamic.yaml",
    "config.d.ts",
    "dist"
  ],
  "scalprum": {
    "name": "backstage-community.plugin-argocd",
    "exposedModules": {
      "PluginRoot": "./src/index.ts",
      "Legacy": "./src/legacy.ts"
    }
  },
  "configSchema": "config.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/community-plugins",
    "directory": "workspaces/argocd/plugins/argocd"
  },
  "keywords": [
    "backstage",
    "plugin"
  ],
  "bugs": "https://github.com/backstage/community-plugins/issues",
  "maintainers": [
    "karthikjeeyar",
    "rohitkrai03",
    "Eswaraiahsapram"
  ],
  "author": "Red Hat"
}
