{
  "name": "@backstage-community/plugin-tekton",
  "version": "4.0.3",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.ts",
    "./legacy": "./src/legacy.ts",
    "./translations": "./src/translations/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.ts"
      ],
      "legacy": [
        "src/legacy.ts"
      ],
      "translations": [
        "src/translations/index.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "tekton",
    "pluginPackage": "@backstage-community/plugin-tekton",
    "pluginPackages": [
      "@backstage-community/plugin-tekton",
      "@backstage-community/plugin-tekton-common",
      "@backstage-community/plugin-tekton-react"
    ]
  },
  "sideEffects": [
    "./**/*.css",
    "./**/*.css.esm.js"
  ],
  "scripts": {
    "start": "backstage-cli package start",
    "start:legacy": "backstage-cli package start --entrypoint dev/legacy.tsx",
    "start:mock": "backstage-cli package start --entrypoint dev/index.mock.tsx",
    "start:legacy:mock": "backstage-cli package start --entrypoint dev/legacy.mock.tsx",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test --passWithNoTests --coverage",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "prepublish": "./fix-style-inject-imports.sh"
  },
  "dependencies": {
    "@aonic-ui/pipelines": "^3.1.0",
    "@backstage-community/plugin-tekton-common": "workspace:^",
    "@backstage-community/plugin-tekton-react": "workspace:^",
    "@backstage/catalog-model": "backstage:^",
    "@backstage/core-components": "backstage:^",
    "@backstage/core-plugin-api": "backstage:^",
    "@backstage/frontend-plugin-api": "backstage:^",
    "@backstage/plugin-app-react": "backstage:^",
    "@backstage/plugin-catalog-react": "backstage:^",
    "@backstage/plugin-kubernetes-common": "backstage:^",
    "@backstage/plugin-kubernetes-react": "backstage:^",
    "@backstage/plugin-permission-react": "backstage:^",
    "@backstage/theme": "backstage:^",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.11.4",
    "@kubernetes/client-node": "1.4.0",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@patternfly/patternfly": "^6.0.0",
    "@patternfly/react-core": "^6.0.0",
    "@patternfly/react-table": "^6.3.1",
    "@patternfly/react-tokens": "^6.0.0",
    "@patternfly/react-topology": "^6.0.0",
    "@tanstack/react-query": "^5.62.7",
    "classnames": "^2.3.2",
    "dagre": "^0.8.5",
    "lodash": "^4.17.21",
    "mobx-react": "^7.6.0",
    "react-use": "^17.4.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.30.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@backstage/catalog-client": "backstage:^",
    "@backstage/cli": "backstage:^",
    "@backstage/dev-utils": "backstage:^",
    "@backstage/filter-predicates": "backstage:^",
    "@backstage/frontend-defaults": "backstage:^",
    "@backstage/frontend-test-utils": "backstage:^",
    "@backstage/plugin-catalog": "backstage:^",
    "@backstage/plugin-kubernetes": "backstage:^",
    "@backstage/plugin-permission-common": "backstage:^",
    "@backstage/test-utils": "backstage:^",
    "@backstage/ui": "backstage:^",
    "@playwright/test": "1.61.1",
    "@remixicon/react": "^4.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/dagre": "^0.7.52",
    "@types/lodash": "4.17.24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "cross-fetch": "4.1.0",
    "react": "^18.0.2",
    "react-aria-components": "~1.17.0",
    "react-dom": "^18.0.2",
    "react-router-dom": "^6.30.2"
  },
  "files": [
    "app-config.dynamic.yaml",
    "dist"
  ],
  "scalprum": {
    "name": "backstage-community.plugin-tekton",
    "exposedModules": {
      "PluginRoot": "./src/index.ts",
      "Legacy": "./src/legacy.ts",
      "Alpha": "./src/alpha.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/community-plugins",
    "directory": "workspaces/tekton/plugins/tekton"
  },
  "keywords": [
    "kubernetes",
    "tekton",
    "backstage",
    "plugin"
  ],
  "bugs": "https://github.com/backstage/community-plugins/issues",
  "maintainers": [
    "christoph-jerolimov",
    "@debsmita1",
    "@divyanshiGupta"
  ],
  "author": "Red Hat"
}
