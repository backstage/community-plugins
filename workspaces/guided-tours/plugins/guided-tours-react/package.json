{
  "name": "@backstage-community/plugin-guided-tours-react",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Web library for shipping guided tours from any Backstage frontend plugin",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "homepage": "https://backstage.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/community-plugins",
    "directory": "workspaces/guided-tours/plugins/guided-tours-react"
  },
  "keywords": [
    "backstage",
    "guided-tours",
    "onboarding"
