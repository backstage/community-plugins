{
  "name": "@backstage-community/plugin-scaffolder-backend-module-http-request",
  "description": "Scaffolder action for calling Backstage APIs and proxy endpoints",
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "scaffolder",
    "pluginPackage": "@backstage/plugin-scaffolder-backend"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./new-backend": "./src/new-backend.ts"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ],
      "new-backend": [
        "src/new-backend.ts"
      ]
    }
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint:check": "backstage-cli package lint",
    "lint:fix": "backstage-cli package lint --fix",
    "tsc": "tsc",
    "prettier:check": "prettier --ignore-unknown --check .",
    "prettier:fix": "prettier --ignore-unknown --write .",
    "test": "backstage-cli package test",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.10.0",
    "@backstage/config": "^1.3.6",
    "@backstage/core-plugin-api": "^1.10.1",
    "@backstage/plugin-scaffolder-node": "^0.13.6",
    "cross-fetch": "^4.0.0"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "^1.11.6",
    "@backstage/cli": "^0.36.5",
    "@backstage/core-app-api": "^1.20.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "winston": "^3.2.1"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/community-plugins",
    "directory": "workspaces/scaffolder/plugins/scaffolder-backend-module-http-request"
  },
  "bugs": "https://github.com/backstage/community-plugins/issues",
  "keywords": [
    "backstage",
    "backend-plugin-module"
  ]
}
