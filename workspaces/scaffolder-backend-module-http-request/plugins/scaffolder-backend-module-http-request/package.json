{
  "name": "@backstage-community/plugin-scaffolder-backend-module-http-request",
  "description": "Scaffolder action for calling Backstage APIs and proxy endpoints",
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "scaffolder",
    "pluginPackage": "@backstage/plugin-scaffolder-backend"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./new-backend": "./src/new-backend.ts"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ],
      "new-backend": [
        "src/new-backend.ts"
      ]
    }
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "backstage:^",
    "@backstage/config": "backstage:^",
    "@backstage/core-plugin-api": "backstage:^",
    "@backstage/plugin-scaffolder-node": "backstage:^",
    "cross-fetch": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "backstage:^",
    "@backstage/cli": "backstage:^",
    "@backstage/core-app-api": "backstage:^",
    "winston": "^3.2.1"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/community-plugins",
    "directory": "workspaces/scaffolder-backend-module-http-request/plugins/scaffolder-backend-module-http-request"
  },
  "bugs": "https://github.com/backstage/community-plugins/issues",
  "keywords": [
    "backstage",
    "backend-plugin-module"
  ]
}
