{
  "name": "@backstage-community/plugin-entity-feedback",
  "version": "0.23.0",
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "entity-feedback",
    "pluginPackages": [
      "@backstage-community/plugin-entity-feedback",
      "@backstage-community/plugin-entity-feedback-backend",
      "@backstage-community/plugin-entity-feedback-common"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha/index.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "homepage": "https://backstage.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/community-plugins",
    "directory": "workspaces/entity-feedback/plugins/entity-feedback"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "start": "backstage-cli package start",
    "start:alpha": "backstage-cli package start --entry-dir dev/alpha --config dev/alpha/app-config.yaml",
    "test": "backstage-cli package test"
  },
  "dependencies": {
    "@backstage-community/plugin-entity-feedback-common": "workspace:^",
    "@backstage/catalog-model": "^1.10.1",
    "@backstage/core-plugin-api": "^1.12.10",
    "@backstage/errors": "^1.3.1",
    "@backstage/filter-predicates": "^0.1.5",
    "@backstage/frontend-plugin-api": "^0.18.1",
    "@backstage/plugin-catalog-react": "^3.2.3",
    "@backstage/ui": "^0.18.0",
    "@remixicon/react": "^4.6.0",
    "@types/react": "^18.0.0",
    "react-use": "^17.2.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.6",
    "@backstage/core-components": "^0.18.14",
    "@backstage/dev-utils": "^1.1.27",
    "@backstage/frontend-defaults": "^0.5.6",
    "@backstage/frontend-test-utils": "^0.6.4",
    "@backstage/plugin-catalog": "^2.0.9",
    "@backstage/test-utils": "^1.7.22",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react-dom": "^18.2.19",
    "msw": "^1.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.2"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.2"
  }
}
